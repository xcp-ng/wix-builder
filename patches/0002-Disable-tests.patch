diff --git a/src/api/api.cmd b/src/api/api.cmd
index 42ca8567..113a10c1 100644
--- a/src/api/api.cmd
+++ b/src/api/api.cmd
@@ -25,14 +25,6 @@
 
 msbuild api_t.proj -p:Configuration=%_C% -tl -nologo -warnaserror -bl:%_L%\api_build.binlog || exit /b
 
-:: Test
-dotnet test ^
- %_B%\net8.0\WixToolsetTest.Data.dll ^
- %_B%\net8.0\win-x86\WixToolsetTest.BootstrapperApplicationApi.dll ^
- %_B%\x86\BalUtilUnitTest.dll ^
- %_B%\x86\BextUtilUnitTest.dll ^
- --nologo -l "trx;LogFileName=%_L%\TestResults\api.trx" || exit /b
-
 @goto :end
 
 :clean
diff --git a/src/build_all.cmd b/src/build_all.cmd
index 7e9e7790..76e2b167 100644
--- a/src/build_all.cmd
+++ b/src/build_all.cmd
@@ -59,11 +59,6 @@ call ext\ext.cmd %_C% || exit /b
