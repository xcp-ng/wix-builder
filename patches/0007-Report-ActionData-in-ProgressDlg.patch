From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tu Dinh <ngoc-tu.dinh@vates.tech>
Date: Sun, 13 Sep 2026 15:31:50 +0200
Subject: [PATCH] Report ActionData in ProgressDlg

Signed-off-by: Tu Dinh <ngoc-tu.dinh@vates.tech>

diff --git a/src/ext/UI/wixlib/ProgressDlg.wxs b/src/ext/UI/wixlib/ProgressDlg.wxs
index b206c173cf40..2e2a5bb4925b 100644
--- a/src/ext/UI/wixlib/ProgressDlg.wxs
+++ b/src/ext/UI/wixlib/ProgressDlg.wxs
@@ -27,7 +27,10 @@
                 <Control Id="ActionText" Type="Text" X="70" Y="100" Width="285" Height="10">
                     <Subscribe Event="ActionText" Attribute="Text" />
                 </Control>
-                <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="115" Width="330" Height="10" ProgressBlocks="yes" Text="!(loc.ProgressDlgProgressBar)">
+                <Control Id="ActionData" Type="Text" X="20" Y="115" Width="330" Height="10">
+                    <Subscribe Event="ActionData" Attribute="Text" />
+                </Control>
+                <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="130" Width="330" Height="10" ProgressBlocks="yes" Text="!(loc.ProgressDlgProgressBar)">
                     <Subscribe Event="SetProgress" Attribute="Progress" />
                 </Control>
                 <Control Id="StatusLabel" Type="Text" X="20" Y="100" Width="50" Height="10" Text="!(loc.ProgressDlgStatusLabel)" />
