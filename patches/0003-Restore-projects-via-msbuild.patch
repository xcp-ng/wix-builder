From 86fe1379e75d60c8058fcdc0d0917e7ccaa4a97f Mon Sep 17 00:00:00 2001
From: Tu Dinh <ngoc-tu.dinh@vates.tech>
Date: Sat, 7 Mar 2026 16:49:15 +0100
Subject: [PATCH 3/4] Restore projects via msbuild

Signed-off-by: Tu Dinh <ngoc-tu.dinh@vates.tech>
---
 src/burn/burn.cmd         |  2 +-
 src/internal/internal.cmd |  2 +-
 src/wix/wix.cmd           |  4 ++--
 src/wix/wix_t.proj        | 19 +++++++++++++++++++
 4 files changed, 23 insertions(+), 4 deletions(-)
 create mode 100644 src/wix/wix_t.proj

diff --git a/src/burn/burn.cmd b/src/burn/burn.cmd
index daed54ed..d3cafef4 100644
--- a/src/burn/burn.cmd
+++ b/src/burn/burn.cmd
@@ -21,7 +21,7 @@
 
 :: burn
 
-nuget restore || exit /b
+msbuild -t:Restore burn.sln -p:Configuration=%_C% -tl -nologo -m -bl:%_L%\burn_restore.binlog || exit /b
 
 msbuild burn_t.proj -p:Configuration=%_C% -tl -nologo -m -warnaserror -bl:%_L%\burn_build.binlog || exit /b
 
diff --git a/src/internal/internal.cmd b/src/internal/internal.cmd
index 40413f55..09666469 100644
--- a/src/internal/internal.cmd
+++ b/src/internal/internal.cmd
@@ -20,7 +20,7 @@
 @echo Building internal %_C%
 
 :: internal
-nuget restore || exit /b
+msbuild -t:Restore internal.sln -p:Configuration=%_C% -tl -nologo -m -bl:%_L%\internal_restore.binlog || exit /b
 
 :: dotnet pack -c %_C% WixBuildTools.MsgGen\WixBuildTools.MsgGen.csproj || exit /b
 :: dotnet pack -c %_C% WixBuildTools.XsdGen\WixBuildTools.XsdGen.csproj || exit /b
diff --git a/src/wix/wix.cmd b/src/wix/wix.cmd
index 4a6fc39f..364f00d3 100644
--- a/src/wix/wix.cmd
+++ b/src/wix/wix.cmd
@@ -20,13 +20,13 @@
 @echo Building wix %_C%
 
 :: Restore
-msbuild -t:Restore wix.sln -p:Configuration=%_C% -tl -nologo -m -warnaserror -bl:%_L%\wix_restore.binlog || exit /b
+msbuild -t:Restore wix_t.proj -p:Configuration=%_C% -tl -nologo -m -bl:%_L%\wix_restore.binlog || exit /b
 
 
 :: Build
 msbuild wixnative\wixnative_t.proj -p:Configuration=%_C% -tl -nologo -m -warnaserror -bl:%_L%\wixnative_build.binlog || exit /b
 
-msbuild wix.sln -p:Configuration=%_C% -tl -nologo -m -warnaserror -bl:%_L%\wix_build.binlog || exit /b
+msbuild wix_t.proj -p:Configuration=%_C% -tl -nologo -m -bl:%_L%\wix_build.binlog || exit /b
 
 msbuild publish_t.proj -p:Configuration=%_C% -tl -nologo -warnaserror -bl:%_L%\wix_publish.binlog || exit /b
 
diff --git a/src/wix/wix_t.proj b/src/wix/wix_t.proj
new file mode 100644
index 00000000..d0494355
--- /dev/null
+++ b/src/wix/wix_t.proj
@@ -0,0 +1,19 @@
+<Project Sdk="Microsoft.Build.Traversal">
+  <ItemGroup>
+    <ProjectReference Include="WixToolset.Core.Native\WixToolset.Core.Native.csproj" />
+    <ProjectReference Include="WixToolset.Core\WixToolset.Core.csproj" />
+    <ProjectReference Include="WixToolset.Core.Burn\WixToolset.Core.Burn.csproj" />
+    <ProjectReference Include="WixToolset.Core.ExtensionCache\WixToolset.Core.ExtensionCache.csproj" />
+    <ProjectReference Include="WixToolset.Core.WindowsInstaller\WixToolset.Core.WindowsInstaller.csproj" />
+
+    <ProjectReference Include="WixToolset.Converters\WixToolset.Converters.csproj" />
+    <ProjectReference Include="WixToolset.Converters.Symbolizer\WixToolset.Converters.Symbolizer.csproj" />
+
+    <ProjectReference Include="WixToolset.BuildTasks\WixToolset.BuildTasks.csproj" />
+    <ProjectReference Include="WixToolset.Sdk\WixToolset.Sdk.csproj" />
+
+    <ProjectReference Include="wixnative\wixnative.vcxproj" Condition="'$(Platform)' != 'ARM64'" />
+    <ProjectReference Include="wix\wix.csproj" />
+    <ProjectReference Include="pack-wix\pack-wix.csproj" />
+  </ItemGroup>
+</Project>
