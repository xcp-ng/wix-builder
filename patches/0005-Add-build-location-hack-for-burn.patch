---
 src/burn/Directory.Build.props | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/burn/Directory.Build.props b/src/burn/Directory.Build.props
index 6050781d..40e24661 100644
--- a/src/burn/Directory.Build.props
+++ b/src/burn/Directory.Build.props
@@ -7,8 +7,8 @@
   </PropertyGroup>
 
   <Import Project="..\Directory.Build.props" />
-  
+
   <PropertyGroup>
-    <BurnGeneratedHeaderDirectory>$(BaseIntermediateOutputPath)..\</BurnGeneratedHeaderDirectory>
+    <BurnGeneratedHeaderDirectory>$(RootBuildFolder)$(SegmentName)\obj\$(Configuration)\$(PlatformFolder)\</BurnGeneratedHeaderDirectory>
   </PropertyGroup>
 </Project>
